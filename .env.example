# Copy this file to .env and fill in your values
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=openai/gpt-4o-mini
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=db/orders.db

# Memory settings
WINDOW_SIZE=10          # last N messages sent verbatim to the LLM
SUMMARY_TRIGGER=10      # summarize once this many messages fall outside the window
